---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CONTACT_EMAIL, POLICY_UPDATED, POLICY_UPDATED_HI, SITE_URL } from '../../lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'गोपनीयता नीति',
  url: `${SITE_URL}/privacy/`,
  inLanguage: 'hi',
  description: 'हिंदी व्याकरण वेबसाइट की गोपनीयता नीति — कौन-सी जानकारी एकत्र होती है और कौन-सी नहीं।',
  dateModified: POLICY_UPDATED,
};
---

<BaseLayout
  title="गोपनीयता नीति"
  description="हिंदी व्याकरण वेबसाइट कौन-सी जानकारी एकत्र करती है और कौन-सी नहीं — कुकीज़, ट्रैकिंग और आपके अधिकारों के बारे में।"
  schema={schema}
>
  <div class="mx-auto max-w-2xl px-4 py-8 md:py-12">
    <Breadcrumbs items={[{ label: 'गोपनीयता नीति' }]} />

    <header class="mt-5">
      <h1 class="text-h1 font-bold text-ink md:text-display">गोपनीयता नीति</h1>
      <p class="mt-3 text-meta text-mute">अंतिम संशोधन — {POLICY_UPDATED_HI}</p>
    </header>

    {/* The whole policy in one sentence, before the sections. Most readers
        will not go past this box, so it has to be the true summary. */}
    <p class="mt-6 rounded-card border-l-2 border-accent bg-surface px-5 py-4 text-ui text-body">
      संक्षेप में — यह साइट आपसे कोई व्यक्तिगत जानकारी नहीं माँगती, कोई खाता नहीं बनवाती, कोई
      ट्रैकिंग या विज्ञापन कुकी नहीं रखती, और आपके पढ़ने का कोई रिकॉर्ड नहीं जोड़ती।
    </p>

    <div class="prose-hi mt-8">
      <h2>1. यह नीति किस पर लागू है</h2>
      <p>
        यह नीति <span class="latin">hindivyakaran.net</span> पर उपलब्ध सभी पृष्ठों, PDF फ़ाइलों और
        सुविधाओं पर लागू होती है। इस साइट पर दिए गए बाहरी लिंक जिन वेबसाइटों पर ले जाते हैं, उन पर
        यह नीति लागू नहीं होती।
      </p>

      <h2>2. हम कौन-सी जानकारी एकत्र नहीं करते</h2>
      <p>यह साइट निम्नलिखित में से कुछ भी नहीं करती:</p>
      <ul>
        <li>नाम, ईमेल, फ़ोन नंबर या कोई अन्य व्यक्तिगत विवरण नहीं माँगती।</li>
        <li>कोई खाता, पंजीकरण या लॉगिन नहीं है।</li>
        <li>कोई ट्रैकिंग या विज्ञापन कुकी नहीं रखी जाती।</li>
        <li>
          कोई विश्लेषण (<span class="latin">analytics</span>) या विज्ञापन नेटवर्क का स्क्रिप्ट
          साइट पर नहीं है।
        </li>
        <li>आपकी पढ़ी गई सामग्री या खोजे गए शब्दों का कोई रिकॉर्ड हमारे पास नहीं जाता।</li>
      </ul>

      <h2>3. आपके ब्राउज़र में क्या सहेजा जाता है</h2>
      <p>
        साइट आपके ब्राउज़र के <span class="latin">local storage</span> में केवल एक मान सहेजती है —
        <code>theme</code> — जो यह याद रखता है कि आपने उजला रूप चुना है या गहरा। यह जानकारी आपके
        उपकरण से बाहर कहीं नहीं जाती, हमें दिखाई नहीं देती, और आप ब्राउज़र की साइट-डेटा सफ़ाई से इसे
        कभी भी हटा सकते हैं। इसके अतिरिक्त कोई कुकी सेट नहीं की जाती।
      </p>

      <h2>4. खोज कैसे काम करती है</h2>
      <p>
        साइट की खोज पूरी तरह आपके ब्राउज़र में चलती है। खोज-सूची एक बार डाउनलोड हो जाती है और उसके
        बाद आप जो भी टाइप करते हैं वह आपके उपकरण पर ही रहता है — कोई खोज-शब्द हमारे या किसी तीसरे
        पक्ष के सर्वर तक नहीं भेजा जाता।
      </p>

      <h2>5. फ़ॉन्ट और बाहरी सेवाएँ</h2>
      <p>
        पृष्ठों में प्रयुक्त देवनागरी फ़ॉन्ट साइट के साथ ही रखे गए हैं (<span class="latin"
          >self-hosted</span
        >)। पढ़ते समय आपका ब्राउज़र किसी बाहरी फ़ॉन्ट या स्क्रिप्ट सेवा से संपर्क नहीं करता।
      </p>

      <h2>6. सर्वर लॉग</h2>
      <p>
        साइट जिस होस्टिंग सेवा पर चलती है, वह अन्य वेब सर्वरों की तरह सामान्य तकनीकी लॉग रख सकती है
        — जैसे अनुरोध किया गया पता, समय, ब्राउज़र का प्रकार और <span class="latin">IP</span> पता।
        यह सुरक्षा और साइट के संचालन के लिए होता है। हम इन लॉग का उपयोग किसी व्यक्ति की पहचान करने
        या उसका व्यवहार जोड़कर देखने के लिए नहीं करते, न ही इन्हें किसी को बेचते या साझा करते हैं।
      </p>

      <h2>7. जब आप हमें ईमेल करें</h2>
      <p>
        यदि आप <a href={`mailto:${CONTACT_EMAIL}`} class="latin">{CONTACT_EMAIL}</a> पर लिखते हैं,
        तो आपका ईमेल पता और संदेश हमारे पास उस ईमेल सेवा में रहता है जहाँ वह आया है। इसका उपयोग हम
        केवल आपके संदेश का उत्तर देने और बताई गई त्रुटि सुधारने के लिए करते हैं। हम इसे किसी
        मेलिंग-सूची में नहीं जोड़ते और न ही किसी अन्य को देते हैं। आप कभी भी लिखकर अपना संदेश हटाने
        का अनुरोध कर सकते हैं।
      </p>

      <h2>8. बच्चों की निजता</h2>
      <p>
        यह साइट विद्यार्थियों द्वारा पढ़ी जाती है। चूँकि यहाँ कोई व्यक्तिगत जानकारी माँगी ही नहीं
        जाती, किसी भी आयु के पाठक से हम जानबूझकर कोई जानकारी एकत्र नहीं करते।
      </p>

      <h2>9. आपके अधिकार</h2>
      <p>
        चूँकि हम आपकी कोई व्यक्तिगत जानकारी संग्रहीत नहीं करते, सामान्यतः हमारे पास हटाने या दिखाने
        के लिए कुछ होता ही नहीं। अपवाद केवल वह ईमेल है जो आपने स्वयं हमें भेजा हो — उसकी एक प्रति
        माँगने या उसे हटवाने के लिए हमें लिख सकते हैं।
      </p>

      <h2>10. नीति में परिवर्तन</h2>
      <p>
        यदि साइट में कोई ऐसी सुविधा जुड़ती है जो इस नीति को प्रभावित करे, तो यह पृष्ठ संशोधित किया
        जाएगा और ऊपर दी गई तिथि बदल दी जाएगी। महत्वपूर्ण परिवर्तन इसी पृष्ठ पर स्पष्ट रूप से लिखे
        जाएँगे।
      </p>

      <h2>11. प्रश्न हों तो</h2>
      <p>
        इस नीति के बारे में कुछ भी पूछना हो तो
        <a href={`mailto:${CONTACT_EMAIL}`} class="latin">{CONTACT_EMAIL}</a> पर लिखें, या
        <a href="/contact/">संपर्क</a> पृष्ठ देखें। साइट के उपयोग की शर्तें
        <a href="/terms/">नियम व शर्तें</a> पृष्ठ पर दी गई हैं।
      </p>
    </div>
  </div>
</BaseLayout>

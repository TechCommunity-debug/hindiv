---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchTrigger from '../components/SearchTrigger.astro';
import TopicCard from '../components/TopicCard.astro';
import { categories, plannedTopics } from '../lib/taxonomy';
import { getAllTopics, categoryUrl } from '../lib/content';

const topics = await getAllTopics();
const featured = topics.slice(0, 6);
const totalPlanned = topics.length + plannedTopics.length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'हिंदी व्याकरण',
  url: 'https://hindivyakaran.net/',
  inLanguage: 'hi',
  description: 'हिंदी व्याकरण का व्यवस्थित संदर्भ — परिभाषा, भेद, उदाहरण और अभ्यास।',
};
---

<BaseLayout
  title="हिंदी व्याकरण — परिभाषा, भेद, उदाहरण और अभ्यास"
  description="संज्ञा, सर्वनाम, क्रिया, काल, कारक, संधि, समास और अलंकार — पूरा हिंदी व्याकरण सरल हिंदी में। उदाहरण और अभ्यास सहित, सात खंडों में व्यवस्थित।"
  schema={schema}
>
  {/*
    Hero. DESIGN.md puts a multi-stop mesh gradient here; it is dropped
    deliberately. That gradient is the single most recognisable "generated
    landing page" signal, and this is a reference work — the type and the
    hairline rules carry it instead.
  */}
  <section class="border-b border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow text-accent">संदर्भ · अध्ययन · अभ्यास</p>

        <h1 class="mt-4 text-h1 font-bold text-ink md:text-[3.25rem] md:leading-[1.25]">
          हिंदी व्याकरण का<br class="hidden sm:block" /> संपूर्ण संदर्भ
        </h1>

        <p class="mt-6 max-w-2xl text-lead text-body">
          परिभाषा, भेद, उदाहरण और अभ्यास — सब कुछ सरल हिंदी में। पढ़ने, समझने और अपनी भाषा
          सुधारने के लिए।
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <SearchTrigger class="w-full py-3 text-ui sm:w-80" />
          <a
            href="/vyakaran/"
            class="inline-flex items-center justify-center rounded-pill bg-ink px-5 py-3 text-ui font-medium text-canvas no-underline transition-opacity hover:opacity-90"
          >
            विषय-सूची देखें
          </a>
        </div>

        <p class="mt-4 text-meta text-mute">
          हिंदी या रोमन — दोनों में खोजें।
          <span class="rounded-control bg-accent-soft px-1.5 py-0.5 font-medium text-accent latin"
            >sangya</span
          > लिखें, <span class="font-medium text-ink">संज्ञा</span> मिलेगा।
        </p>
      </div>
    </div>
  </section>

  {/* Khand grid — the systematic spine, visible immediately. */}
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20" aria-labelledby="khand-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="khand-heading" class="m-0 text-h2 font-semibold text-ink">सात खंड</h2>
      <p class="text-meta text-mute">{totalPlanned} विषय · क्रमबद्ध</p>
    </div>

    <ul class="mt-6 grid gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => {
          const count = topics.filter((topic) => topic.data.category === category.id).length;
          return (
            <li class="list-none" data-khand={category.id}>
              <a
                href={categoryUrl(category.id)}
                class="flex h-full flex-col rounded-card border border-hairline border-s-2 border-s-(--khand) bg-surface p-5 no-underline transition-colors hover:border-(--khand) hover:bg-(--khand-soft)"
              >
                <div class="flex items-center gap-3">
                  <span class="khand-marker shrink-0" aria-hidden="true">
                    {category.marker}
                  </span>
                  <h3 class="m-0 text-h3 font-semibold text-ink">{category.title}</h3>
                </div>
                <p class="mt-3 grow text-ui text-body">{category.summary}</p>
                <p class="mt-4 text-meta font-medium text-(--khand)">
                  {count > 0 ? `${count} विषय तैयार` : 'तैयारी में'}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* Featured topics. */}
  <section
    class="border-y border-hairline bg-surface"
    aria-labelledby="featured-heading"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="featured-heading" class="m-0 text-h2 font-semibold text-ink">प्रमुख विषय</h2>
        <a href="/vyakaran/" class="text-ui text-accent no-underline hover:underline">
          सभी विषय →
        </a>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((topic) => <TopicCard topic={topic} showCategory />)}
      </div>
    </div>
  </section>

  {/* What makes a page here different. Stated as facts about the content,
      not as marketing adjectives. */}
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20" aria-labelledby="how-heading">
    <h2 id="how-heading" class="m-0 text-h2 font-semibold text-ink">हर विषय में क्या मिलेगा</h2>

    {
      /* Each entry is tinted with the colour that role actually wears on
         a topic page — accent for परिभाषा, ochre for उदाहरण, green for
         अभ्यास — so this doubles as a legend for the colour system. */
    }
    <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="border-t-2 border-accent pt-4">
        <dt class="font-serif text-h3 font-semibold text-ink">परिभाषा</dt>
        <dd class="mt-2 m-0 text-ui text-body">
          हर विषय की शुरुआत एक स्पष्ट परिभाषा से, जो एक ही वाक्य में पूरी बात कह दे।
        </dd>
      </div>
      <div class="border-t-2 border-khand-shabd-vichar pt-4">
        <dt class="font-serif text-h3 font-semibold text-ink">भेद</dt>
        <dd class="mt-2 m-0 text-ui text-body">
          हर भेद अलग शीर्षक के साथ, ताकि सीधे उसी भेद पर पहुँचा जा सके।
        </dd>
      </div>
      <div class="border-t-2 border-ochre pt-4">
        <dt class="font-serif text-h3 font-semibold text-ink">उदाहरण</dt>
        <dd class="mt-2 m-0 text-ui text-body">
          हर नियम के साथ उदाहरण — शब्द और पूरे वाक्य, दोनों रूपों में।
        </dd>
      </div>
      <div class="border-t-2 border-correct pt-4">
        <dt class="font-serif text-h3 font-semibold text-ink">अभ्यास</dt>
        <dd class="mt-2 m-0 text-ui text-body">
          अंत में प्रश्न, जिनके उत्तर स्वयं सोचने के बाद ही खुलते हैं।
        </dd>
      </div>
    </dl>
  </section>

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center md:py-24">
      <h2 class="m-0 text-h1 font-bold text-ink">कहाँ से शुरू करें?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lead text-body">
        यदि पहली बार पढ़ रहे हैं, तो वर्ण विचार से आरंभ करें। शब्दों के रूप और भेद समझने हों, तो
        सीधे शब्द विचार पर जाएँ।
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {/* Each CTA wears the colour of the खंड it leads to. */}
        <a
          href="/vyakaran/varn-vichar/"
          data-khand="varn-vichar"
          class="inline-flex items-center rounded-pill bg-(--khand) px-5 py-3 text-ui font-medium text-canvas no-underline transition-opacity hover:opacity-90"
        >
          वर्ण विचार से शुरू करें
        </a>
        <a
          href="/vyakaran/shabd-vichar/"
          data-khand="shabd-vichar"
          class="inline-flex items-center rounded-pill border border-(--khand) bg-(--khand-soft) px-5 py-3 text-ui font-medium text-(--khand) no-underline transition-colors hover:bg-surface"
        >
          शब्द विचार देखें
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

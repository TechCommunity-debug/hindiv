---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompletePdfCta from '../components/CompletePdfCta.astro';
import DownloadIcon from '../components/DownloadIcon.astro';
import { categories, plannedTopics, levels } from '../lib/taxonomy';
import { getAllTopics, topicUrl } from '../lib/content';
import { PDF_LANDING_URL } from '../lib/pdf';
import { CONTACT_EMAIL, sitePages, SITE_URL } from '../lib/site';

const topics = await getAllTopics();
const totalPlanned = topics.length + plannedTopics.length;

/**
 * The head terms this page is written for. "Hindi vyakaran" is the one
 * the domain, the H1, the title and the body copy all agree on; the PDF
 * variants are carried mainly by /pdf/, and appear here only because a
 * home page that never says the word cannot rank for it either.
 */
const title = 'Hindi Vyakaran — हिंदी व्याकरण | Hindi Grammar PDF Download';
const description =
  `हिंदी व्याकरण (Hindi Vyakaran) का सम्पूर्ण निःशुल्क संदर्भ — ${categories.length} खंड, ${topics.length} विषय, ` +
  'परिभाषा, भेद, उदाहरण और अभ्यास सहित। पूरी Hindi grammar book PDF भी मुफ़्त डाउनलोड करें।';

/**
 * Asked and answered on the page itself, and fed to FAQPage schema from
 * the same array — so the rich result can never drift from what a reader
 * actually sees, which is the thing that gets FAQ markup penalised.
 */
const faqs = [
  {
    q: 'हिंदी व्याकरण किसे कहते हैं? (Hindi vyakaran kise kahate hain)',
    a: 'हिंदी भाषा को शुद्ध रूप में बोलने, पढ़ने और लिखने के नियमों के व्यवस्थित शास्त्र को हिंदी व्याकरण कहते हैं। यह वर्ण, शब्द, वाक्य और रचना — इन चार स्तरों पर भाषा के नियम बताता है, अर्थात् ध्वनि कैसे बनती है, शब्द कैसे बदलते हैं, और शब्द मिलकर शुद्ध वाक्य कैसे बनाते हैं।',
  },
  {
    q: 'What is vyakaran in Hindi?',
    a: 'Vyakaran (व्याकरण) is the Hindi word for grammar — the systematic set of rules that govern how a language is correctly spoken, read and written. Hindi vyakaran studies the language at four levels: varn vichar (sounds and letters), shabd vichar (words and their forms), vakya vichar (sentences) and rachna (composition).',
  },
  {
    q: 'हिंदी व्याकरण के जनक कौन हैं? (Hindi vyakaran ke janak kaun hai)',
    a: 'हिंदी व्याकरण का जनक सामान्यतः पं. कामताप्रसाद गुरु को माना जाता है, जिनकी पुस्तक "हिन्दी व्याकरण" (1920) हिंदी का पहला व्यवस्थित और प्रामाणिक व्याकरण ग्रंथ मानी जाती है। इससे पहले 12वीं शताब्दी में दामोदर पंडित की "उक्ति-व्यक्ति-प्रकरण" तथा 1796 में जॉन गिलक्राइस्ट का "A Grammar of the Hindoostanee Language" आरंभिक प्रयास थे।',
  },
  {
    q: 'हिंदी व्याकरण के कितने भेद होते हैं?',
    a: 'हिंदी व्याकरण के मुख्यतः चार भेद (अंग) होते हैं — वर्ण विचार, शब्द विचार, वाक्य विचार और छंद विचार। वर्ण विचार में वर्णमाला, स्वर-व्यंजन और संधि; शब्द विचार में संज्ञा, सर्वनाम, विशेषण, क्रिया, समास और उपसर्ग-प्रत्यय; वाक्य विचार में वाक्य के भेद, पद-परिचय और वाक्य-शुद्धि; तथा छंद विचार में छंद, रस और अलंकार पढ़े जाते हैं।',
  },
  {
    q: 'What is karak in Hindi grammar?',
    a: 'Karak (कारक) is the grammatical relation between a noun or pronoun and the verb of a sentence — roughly what case marking does in English grammar. Hindi has eight karak: karta (कर्ता, subject), karm (कर्म, object), karan (करण, instrument), sampradan (सम्प्रदान, recipient), apadan (अपादान, separation), sambandh (सम्बन्ध, relation), adhikaran (अधिकरण, location) and sambodhan (सम्बोधन, address). Each is marked by its own vibhakti or parsarg, such as ne, ko, se, ke liye, ka/ke/ki and mein/par.',
  },
  {
    q: 'What is karm in Hindi grammar?',
    a: 'Karm karak (कर्म कारक) is the object of a sentence — the person or thing on which the action of the verb falls. Its vibhakti is "को", though it is often left unmarked: in "राम ने पत्र लिखा" the karm is पत्र, and in "राम ने मोहन को बुलाया" it is मोहन. To find the karm, ask क्या or किसको of the verb.',
  },
  {
    q: 'हिंदी व्याकरण में सबसे पहले क्या पढ़ना चाहिए?',
    a: 'सबसे पहले वर्ण विचार पढ़ना चाहिए — वर्णमाला, स्वर और व्यंजन, फिर संधि। ध्वनि और वर्ण की समझ के बिना शब्द-रूप समझ नहीं आते। इसके बाद शब्द विचार (संज्ञा, सर्वनाम, विशेषण, क्रिया) और तब वाक्य विचार पढ़ें। शब्द भंडार, अलंकार और रचना अंत के लिए रखें, क्योंकि वे पढ़ने से अधिक अभ्यास से आते हैं।',
  },
  {
    q: 'शुरू से व्याकरण कैसे सीखें?',
    a: 'शुरू से व्याकरण सीखने का सरल क्रम यह है — पहले वर्णमाला और उच्चारण, फिर संधि, फिर शब्दों के भेद (संज्ञा, सर्वनाम, विशेषण, क्रिया, कारक), उसके बाद वाक्य रचना और वाक्य-शुद्धि, और अंत में समास, मुहावरे, पर्यायवाची, अलंकार तथा रस-छंद। हर विषय की परिभाषा और भेद पढ़ने के बाद उदाहरण देखें और अभ्यास-प्रश्न स्वयं हल करें — व्याकरण पढ़ लेने और व्याकरण आ जाने के बीच का अंतर वहीं तय होता है।',
  },
];

/**
 * The home page is the contents list — there are no per-खंड pages behind
 * it. So each khand is grouped here with its topics inline, and the
 * section `id` is what every khand link on the site anchors to.
 */
const khand = categories.map((category) => ({
  category,
  written: topics.filter((topic) => topic.data.category === category.id),
  planned: plannedTopics.filter((topic) => topic.category === category.id),
}));

/** First topic of a khand — what "start here" should actually open. */
const firstOf = (id: string) => topics.find((topic) => topic.data.category === id);
const startVarn = firstOf('varn-vichar');
const startShabd = firstOf('shabd-vichar');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Hindi vyakaran',
    alternateName: ['हिंदी व्याकरण', 'Hindi Grammar', 'Hindi Vyakaran'],
    url: 'https://hindivyakaran.net/',
    inLanguage: 'hi',
    description,
    /* The site search, declared so a query that is really "संधि on this
       site" can be answered by a sitelinks search box rather than by a
       second search. The dialog reads ?q= on load. */
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE_URL}/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  /* The FAQ block near the foot of the page, declared from the same
     array that renders it. */
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  /* The publisher behind the site, with the contact address and the pages
     that stand behind it. Search engines read this as the site's identity —
     an About and a Contact page that are reachable and declared are part of
     what separates a reference from scraped filler. */
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Hindi vyakaran',
    url: 'https://hindivyakaran.net/',
    email: CONTACT_EMAIL,
    description:
      'हिंदी व्याकरण का एक स्वतंत्र, निःशुल्क ऑनलाइन संदर्भ — परिभाषा, भेद, उदाहरण और अभ्यास सहित।',
    contactPoint: {
      '@type': 'ContactPoint',
      email: CONTACT_EMAIL,
      contactType: 'customer support',
      availableLanguage: ['hi', 'en'],
    },
  },
  /* The contents list is the page's main content, so it is declared as
     one — seven sections, each an ordered list of its topics. */
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'हिंदी व्याकरण — विषय-सूची',
    itemListElement: khand.map(({ category, written }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: category.title,
      item: {
        '@type': 'ItemList',
        name: category.title,
        itemListElement: written.map((topic, j) => ({
          '@type': 'ListItem',
          position: j + 1,
          name: topic.data.title,
          url: new URL(topicUrl(topic), 'https://hindivyakaran.net').href,
        })),
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  keywords="hindi vyakaran, हिंदी व्याकरण, hindi grammar, hindi vyakaran pdf, hindi grammar pdf, hindi vyakaran book, hindi vyakaran book pdf, hindi vyakaran pdf download, hindi grammar pdf download"
>
  {/*
    Hero. DESIGN.md puts a multi-stop mesh gradient here; it is dropped
    deliberately. That gradient is the single most recognisable "generated
    landing page" signal, and this is a reference work — the type and the
    hairline rules carry it instead.
  */}
  <section class="border-b border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-8 md:py-12">
      <div class="max-w-3xl">
        <p class="eyebrow text-accent">संदर्भ · अध्ययन · अभ्यास</p>

        {/* The H1 carries the head term in both scripts. A reader typing
            "hindi vyakaran" and a reader typing "हिंदी व्याकरण" are the
            same reader, and the page has to answer to both spellings. */}
        <h1 class="mt-4 text-h1 font-bold text-ink md:text-[3.25rem] md:leading-[1.25]">
          <span class="latin">Hindi Vyakaran</span> |<br class="hidden sm:block" /> सीखें सम्पूर्ण हिंदी
          व्याकरण
        </h1>

        <p class="mt-6 max-w-2xl text-lead text-body">
          {categories.length} खंड, {topics.length} विषय — परिभाषा, भेद, उदाहरण और अभ्यास, सब कुछ सरल
          हिंदी में। पूरी <span class="latin">Hindi grammar book</span> PDF में मुफ़्त डाउनलोड भी करें।
        </p>

        {/* Routed to /pdf/ rather than straight at the file. A reader in
            the hero has not chosen between the whole book and one topic
            yet, and firing a 3.7 MB download at someone who wanted
            संधि is the wrong default — the landing page offers both. */}
        <div class="mt-7">
          <a
            href={PDF_LANDING_URL}
            class="inline-flex items-center gap-2.5 rounded-pill bg-accent px-5 py-3 text-ui font-semibold text-white no-underline transition-colors hover:bg-accent-deep"
          >
            <DownloadIcon class="size-4" />
            Download PDF
          </a>
        </div>
      </div>
    </div>
  </section>

  {/*
    The contents list. Seven खंड, each a coloured band over its own
    topics — the whole grammar visible and one click from here, which is
    what replaced the khand landing pages that used to sit in between.
  */}
  <section class="mx-auto max-w-6xl px-4 py-8 md:py-12" aria-labelledby="khand-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="khand-heading" class="m-0 text-h2 font-semibold text-ink">सात खंड</h2>
      <p class="text-meta text-mute">{totalPlanned} विषय · क्रमबद्ध</p>
    </div>

    <div class="mt-6 flex flex-col gap-7">
      {
        khand.map(({ category, written, planned }) => (
          <section id={category.id} data-khand={category.id} class="scroll-mt-24">
            {/* The band carries the खंड's colour solid; the rows below
                carry the same colour as a tint, and fill to the band's
                colour on hover. */}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 rounded-card bg-(--khand) px-4 py-3">
              <span
                class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded-control bg-canvas/25 px-1.5 font-mono text-meta font-semibold text-canvas"
                aria-hidden="true"
              >
                {category.marker}
              </span>
              {/* Devanagari and Latin sit on one shared baseline — centring
                  them separately drops the Latin, because the two scripts
                  have very different line boxes at the same size. */}
              <h3 class="m-0 flex flex-wrap items-baseline gap-x-2 text-h3 font-semibold text-canvas">
                {category.title}
                <span class="font-normal latin">({category.titleEn})</span>
              </h3>
              <span class="ml-auto text-meta text-canvas/75">
                {written.length > 0 ? `${written.length} विषय` : 'तैयारी में'}
              </span>
            </div>

            <p class="mt-3 max-w-2xl text-ui text-body">{category.summary}</p>

            {written.length > 0 ? (
              <ul class="mt-3 grid gap-1.5 p-0 md:grid-cols-2">
                {written.map((topic, i) => (
                  <li class="list-none">
                    <a
                      href={topicUrl(topic)}
                      class="group flex items-baseline gap-x-3 rounded-control bg-(--khand-soft) px-3.5 py-2.5 no-underline transition-colors hover:bg-(--khand)"
                    >
                      <span
                        class="w-5 shrink-0 font-mono text-meta tabular-nums text-(--khand) transition-colors group-hover:text-canvas"
                        aria-hidden="true"
                      >
                        {i + 1}
                      </span>
                      <span class="font-serif text-h3 font-semibold text-ink transition-colors group-hover:text-canvas">
                        {topic.data.title}
                      </span>
                      <span class="hidden text-h3 text-ink transition-colors group-hover:text-canvas latin sm:inline">
                        ({topic.data.titleEn})
                      </span>
                      <span class="ml-auto shrink-0 text-meta text-mute transition-colors group-hover:text-canvas/75">
                        {levels[topic.data.level].label}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-3 rounded-control border border-dashed border-hairline px-3.5 py-2.5 text-ui text-mute">
                इस खंड के विषय अभी तैयार किए जा रहे हैं।
              </p>
            )}

            {planned.length > 0 && (
              <ul class="mt-1.5 grid gap-1.5 p-0 md:grid-cols-2">
                {planned.map((topic) => (
                  <li class="flex list-none items-baseline gap-x-3 rounded-control border border-dashed border-hairline px-3.5 py-2.5">
                    <span class="w-5 shrink-0" aria-hidden="true" />
                    <span class="font-serif text-h3 text-faint">{topic.title}</span>
                    <span class="ml-auto shrink-0 text-meta text-faint">शीघ्र</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </section>

  {/* What makes a page here different. Stated as facts about the content,
      not as marketing adjectives. */}
  <section
    class="border-y border-hairline bg-surface"
    aria-labelledby="how-heading"
  >
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
      <h2 id="how-heading" class="m-0 text-h2 font-semibold text-ink">हर विषय में क्या मिलेगा</h2>

      {
        /* Each entry is tinted with the colour that role actually wears on
           a topic page — accent for परिभाषा, ochre for उदाहरण, green for
           अभ्यास — so this doubles as a legend for the colour system. */
      }
      <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-t-2 border-accent pt-4">
          <dt class="font-serif text-h3 font-semibold text-ink">परिभाषा</dt>
          <dd class="mt-2 m-0 text-ui text-body">
            हर विषय की शुरुआत एक स्पष्ट परिभाषा से, जो एक ही वाक्य में पूरी बात कह दे।
          </dd>
        </div>
        <div class="border-t-2 border-khand-shabd-vichar pt-4">
          <dt class="font-serif text-h3 font-semibold text-ink">भेद</dt>
          <dd class="mt-2 m-0 text-ui text-body">
            हर भेद अलग शीर्षक के साथ, ताकि सीधे उसी भेद पर पहुँचा जा सके।
          </dd>
        </div>
        <div class="border-t-2 border-ochre pt-4">
          <dt class="font-serif text-h3 font-semibold text-ink">उदाहरण</dt>
          <dd class="mt-2 m-0 text-ui text-body">
            हर नियम के साथ उदाहरण — शब्द और पूरे वाक्य, दोनों रूपों में।
          </dd>
        </div>
        <div class="border-t-2 border-correct pt-4">
          <dt class="font-serif text-h3 font-semibold text-ink">अभ्यास</dt>
          <dd class="mt-2 m-0 text-ui text-body">
            अंत में प्रश्न, जिनके उत्तर स्वयं सोचने के बाद ही खुलते हैं।
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-4 py-14 text-center md:py-20">
      <h2 class="m-0 text-h1 font-bold text-ink">कहाँ से शुरू करें?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lead text-body">
        यदि पहली बार पढ़ रहे हैं, तो वर्ण विचार से आरंभ करें। शब्दों के रूप और भेद समझने हों, तो
        सीधे शब्द विचार पर जाएँ।
      </p>
      {/* Each CTA opens the first topic of its खंड, not a listing —
          "start here" should land on something to read. */}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {
          startVarn && (
            <a
              href={topicUrl(startVarn)}
              data-khand="varn-vichar"
              class="inline-flex items-center rounded-pill bg-(--khand) px-5 py-3 text-ui font-medium text-canvas no-underline transition-opacity hover:opacity-90"
            >
              वर्ण विचार से शुरू करें
            </a>
          )
        }
        {
          startShabd && (
            <a
              href={topicUrl(startShabd)}
              data-khand="shabd-vichar"
              class="inline-flex items-center rounded-pill border border-(--khand) bg-(--khand-soft) px-5 py-3 text-ui font-medium text-(--khand) no-underline transition-colors hover:bg-surface"
            >
              शब्द विचार देखें
            </a>
          )
        }
      </div>
    </div>
  </section>

  {/*
    The long-form section. It sits here, below the contents list and the
    two start links, on purpose: a reader who came to open संधि has
    already been served three screens earlier, and prose this long above
    the fold would push the actual grammar off it. What it is for is the
    reader — and the crawler — who arrives on "hindi vyakaran" cold and
    needs the page to say plainly what this is, what is in it, and what
    the PDF contains.
  */}
  <section class="border-t border-hairline" aria-labelledby="about-vyakaran">
    <div class="mx-auto max-w-3xl px-4 py-14 md:py-20">
      <div class="prose-hi">
        <h2 id="about-vyakaran">हिंदी व्याकरण (Hindi Vyakaran) — सम्पूर्ण ऑनलाइन संदर्भ</h2>

        <p>
          व्याकरण वह शास्त्र है जो भाषा को शुद्ध रूप में बोलने, पढ़ने और लिखने के नियम बताता है। <strong
            >हिंदी व्याकरण</strong

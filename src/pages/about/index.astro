---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CONTACT_EMAIL, SITE_NAME, SITE_URL } from '../../lib/site';
import { categories } from '../../lib/taxonomy';
import { getAllTopics } from '../../lib/content';

const topics = await getAllTopics();

/* AboutPage rather than a bare WebPage: this is the page search engines
   should read as the site's own account of itself, and the nested
   `mainEntity` is what carries the publisher identity to them. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'हमारे बारे में',
  url: `${SITE_URL}/about/`,
  inLanguage: 'hi',
  description:
    'हिंदी व्याकरण संदर्भ के बारे में — उद्देश्य, सामग्री की तैयारी और संपादकीय नीति।',
  mainEntity: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    email: CONTACT_EMAIL,
    description:
      'हिंदी व्याकरण का एक स्वतंत्र, निःशुल्क ऑनलाइन संदर्भ — परिभाषा, भेद, उदाहरण और अभ्यास सहित।',
  },
};
---

<BaseLayout
  title="हमारे बारे में"
  description="हिंदी व्याकरण संदर्भ किसके लिए है, सामग्री कैसे तैयार की जाती है, और इसके पीछे का उद्देश्य क्या है।"
  schema={schema}
>
  <div class="mx-auto max-w-2xl px-4 py-8 md:py-12">
    <Breadcrumbs items={[{ label: 'हमारे बारे में' }]} />

    <header class="mt-5">
      <h1 class="text-h1 font-bold text-ink md:text-display">हमारे बारे में</h1>
      <p class="mt-4 text-lead text-body">
        हिंदी व्याकरण को पाठ्यपुस्तक की तरह क्रमबद्ध, पर वेब की तरह सुलभ बनाने का एक प्रयास।
      </p>
    </header>

    <div class="prose-hi mt-8">
      <h2>हम क्या बना रहे हैं</h2>
      <p>
        <strong>{SITE_NAME}</strong> (<span class="latin">hindivyakaran.net</span>) हिंदी व्याकरण का
        एक स्वतंत्र और निःशुल्क संदर्भ है। इसका उद्देश्य सरल है — व्याकरण की वह सामग्री, जो अब तक
        बिखरी हुई या केवल मुद्रित पुस्तकों में उपलब्ध थी, एक ही स्थान पर व्यवस्थित क्रम में
        प्रस्तुत करना।
      </p>
      <p>
        सामग्री {categories.length} खंडों में बँटी है और इस समय {topics.length} विषय पूर्ण रूप से
        लिखे जा चुके हैं। यह क्रम मनमाना नहीं है — ध्वनि से शब्द, शब्द से वाक्य, और वाक्य से रचना तक
        — वही क्रम जिसमें एक अवधारणा अगली की नींव रखती है।
      </p>

      <h2>यह किनके लिए है</h2>
      <ul>
        <li>
          <strong>विद्यार्थी</strong> — कक्षा 6 से 12 तक और प्रतियोगी परीक्षाओं की तैयारी करने वाले।
        </li>
        <li>
          <strong>शिक्षक</strong> — जिन्हें पढ़ाने के लिए स्पष्ट परिभाषाएँ, उदाहरण और अभ्यास प्रश्न
          चाहिए।
        </li>
        <li>
          <strong>लेखक और अनुवादक</strong> — जिन्हें लिखते समय किसी नियम की त्वरित पुष्टि करनी हो।
        </li>
        <li>
          <strong>हर वह पाठक</strong> — जो अपनी भाषा को बेहतर समझना और शुद्ध लिखना चाहता है।
        </li>
      </ul>

      <h2>सामग्री कैसे तैयार होती है</h2>
      <p>
        प्रत्येक विषय पारंपरिक हिंदी व्याकरण ग्रंथों और मानक शैक्षिक स्रोतों के आधार पर लिखा जाता
        है, फिर एक ही ढाँचे में ढाला जाता है — परिभाषा, भेद, उदाहरण, ध्यान देने योग्य बिंदु और
        अभ्यास। इससे पाठक को हर पृष्ठ पर यह जानने में समय नहीं लगाना पड़ता कि क्या कहाँ मिलेगा।
      </p>
      <p>
        व्याकरण में मतभेद सामान्य हैं — अलग-अलग ग्रंथ भेदों की संख्या भिन्न बताते हैं। जहाँ ऐसा है,
        वहाँ हम एक मत को सही और दूसरे को गलत कहने के बजाय दोनों का उल्लेख करते हैं और अंतर स्पष्ट
        करते हैं।
      </p>

      <h2>हमारे सिद्धांत</h2>
      <ul>
        <li>
          <strong>निःशुल्क और खुला</strong> — कोई शुल्क नहीं, कोई पंजीकरण नहीं, कोई लॉगिन नहीं।
          पूरी सामग्री सबके लिए समान रूप से उपलब्ध है।
        </li>
        <li>
          <strong>सरल भाषा</strong> — पारिभाषिक शब्द वहीं, जहाँ अनिवार्य हों, और उनका अर्थ साथ ही।
        </li>
        <li>
          <strong>पाठक की निजता</strong> — कोई ट्रैकिंग नहीं, कोई विज्ञापन नेटवर्क नहीं। विस्तार से
          <a href="/privacy/">गोपनीयता नीति</a> में।
        </li>
        <li>
          <strong>ऑफ़लाइन उपयोग</strong> — हर विषय और पूरी पुस्तक <a href="/pdf/">PDF रूप</a> में
          डाउनलोड की जा सकती है, ताकि धीमे या अनुपलब्ध इंटरनेट पर भी पढ़ाई न रुके।
        </li>
      </ul>

      <h2>सुधार में सहयोग</h2>
      <p>
        यह काम चलता रहने वाला है — नए विषय जुड़ते हैं और पुराने संशोधित होते हैं। यदि आपको कोई
        त्रुटि दिखे, कोई उदाहरण भ्रामक लगे, या कोई विषय छूटा हुआ लगे, तो कृपया हमें बताएँ। पाठकों से
        मिली सूचनाएँ ही इस संदर्भ को शुद्ध रखती हैं।
      </p>
      <p>
        लिखें — <a href={`mailto:${CONTACT_EMAIL}`} class="latin">{CONTACT_EMAIL}</a>, या
        <a href="/contact/">संपर्क पृष्ठ</a> देखें।
      </p>

      <h2>आगे पढ़ें</h2>
      <p>
        संदर्भ की संरचना और उपयोग के बारे में विस्तार से <a href="/parichay/">परिचय</a> पृष्ठ पर
        लिखा है। सीधे पढ़ना शुरू करने के लिए <a href="/">विषय-सूची</a> देखें।
      </p>
    </div>
  </div>
</BaseLayout>

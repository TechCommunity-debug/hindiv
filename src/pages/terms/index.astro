---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CONTACT_EMAIL, POLICY_UPDATED, POLICY_UPDATED_HI, SITE_NAME, SITE_URL } from '../../lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'नियम व शर्तें',
  url: `${SITE_URL}/terms/`,
  inLanguage: 'hi',
  description: 'हिंदी व्याकरण वेबसाइट की सामग्री के उपयोग की शर्तें, अधिकार और सीमाएँ।',
  dateModified: POLICY_UPDATED,
};
---

<BaseLayout
  title="नियम व शर्तें"
  description="हिंदी व्याकरण वेबसाइट के उपयोग की शर्तें — सामग्री का उपयोग, अधिकार, उत्तरदायित्व की सीमा और संपर्क।"
  schema={schema}
>
  <div class="mx-auto max-w-2xl px-4 py-8 md:py-12">
    <Breadcrumbs items={[{ label: 'नियम व शर्तें' }]} />

    <header class="mt-5">
      <h1 class="text-h1 font-bold text-ink md:text-display">नियम व शर्तें</h1>
      <p class="mt-3 text-meta text-mute">अंतिम संशोधन — {POLICY_UPDATED_HI}</p>
    </header>

    <p class="mt-6 rounded-card border-l-2 border-accent bg-surface px-5 py-4 text-ui text-body">
      संक्षेप में — सामग्री पढ़ने, डाउनलोड करने और कक्षा में पढ़ाने के लिए स्वतंत्र है। स्रोत का
      उल्लेख करें, उसे अपना बताकर या थोक में पुनःप्रकाशित न करें, और इसे प्रामाणिक ग्रंथ के स्थान
      पर अंतिम प्रमाण न मानें।
    </p>

    <div class="prose-hi mt-8">
      <h2>1. स्वीकृति</h2>
      <p>
        <span class="latin">hindivyakaran.net</span> ("यह साइट") का उपयोग करने पर यह माना जाता है कि
        आपने नीचे दी गई शर्तें पढ़ ली हैं और उनसे सहमत हैं। यदि आप इनसे सहमत न हों, तो कृपया साइट का
        उपयोग न करें।
      </p>

      <h2>2. सामग्री का उद्देश्य</h2>
      <p>
        यहाँ दी गई सारी सामग्री केवल शैक्षिक और सूचनात्मक उद्देश्य से प्रस्तुत की गई है। यह हिंदी
        व्याकरण के अध्ययन में सहायता के लिए है — किसी विद्यालय, बोर्ड, विश्वविद्यालय या परीक्षा
        संस्था का आधिकारिक पाठ्यक्रम या प्रामाणिक घोषणा नहीं।
      </p>

      <h2>3. आप सामग्री का उपयोग कैसे कर सकते हैं</h2>
      <p>व्यक्तिगत अध्ययन और अव्यावसायिक शैक्षिक उपयोग के लिए आप स्वतंत्र रूप से —</p>
      <ul>
        <li>पृष्ठ पढ़ सकते हैं, प्रिंट कर सकते हैं और PDF डाउनलोड कर सकते हैं;</li>
        <li>कक्षा में पढ़ाने, नोट्स बनाने या विद्यार्थियों के साथ साझा करने में उपयोग कर सकते हैं;</li>
        <li>
          उचित मात्रा में उद्धरण दे सकते हैं, बशर्ते स्रोत के रूप में
          <strong>{SITE_NAME} (hindivyakaran.net)</strong> का स्पष्ट उल्लेख हो।
        </li>
      </ul>

      <h2>4. जिसकी अनुमति नहीं है</h2>
      <ul>
        <li>
          सामग्री को, पूर्ण या आंशिक रूप से, अपनी मूल रचना बताकर प्रस्तुत करना या स्रोत हटाकर
          पुनःप्रकाशित करना।
        </li>
        <li>
          पूरे पृष्ठों या PDF को किसी अन्य वेबसाइट, ऐप या पुस्तक में थोक रूप से पुनःप्रकाशित करना,
          बिना लिखित अनुमति के।
        </li>
        <li>सामग्री बेचना, या उसे किसी शुल्क-आधारित सेवा के पीछे रखना।</li>
        <li>
          स्वचालित साधनों से साइट पर अत्यधिक भार डालना, या उसकी सुरक्षा में बाधा पहुँचाने का प्रयास
          करना।
        </li>
      </ul>
      <p>
        इनसे भिन्न किसी उपयोग के लिए
        <a href={`mailto:${CONTACT_EMAIL}`} class="latin">{CONTACT_EMAIL}</a> पर अनुमति माँगी जा
        सकती है। शैक्षिक अनुरोधों पर सामान्यतः सहमति दी जाती है।
      </p>

      <h2>5. बौद्धिक संपदा</h2>
      <p>
        इस साइट पर लिखे गए पाठ, व्याख्याएँ, अभ्यास प्रश्न, संरचना और डिज़ाइन पर अधिकार
        {SITE_NAME} के पास सुरक्षित हैं। हिंदी व्याकरण के मूल नियम, पारंपरिक परिभाषाएँ, लोकप्रचलित
        उदाहरण और साहित्यिक उद्धरण सार्वजनिक ज्ञान का भाग हैं और उन पर किसी का स्वामित्व नहीं — यहाँ
        केवल उनकी प्रस्तुति सुरक्षित है।
      </p>

      <h2>6. सामग्री की शुद्धता</h2>
      <p>
        सामग्री को यथासंभव शुद्ध और मानक स्रोतों के अनुरूप रखने का पूरा प्रयास किया जाता है, फिर भी
        त्रुटि की संभावना बनी रहती है। व्याकरण के अनेक प्रश्नों पर विभिन्न ग्रंथों में मतभेद है, और
        जहाँ ऐसा है वहाँ हमने उसे स्पष्ट लिखने का प्रयास किया है। परीक्षा, प्रकाशन या किसी
        निर्णायक प्रयोजन के लिए कृपया अपने पाठ्यक्रम या किसी मानक व्याकरण ग्रंथ से पुष्टि अवश्य कर
        लें।
      </p>
      <p>
        कोई त्रुटि दिखे तो <a href="/contact/">संपर्क</a> पृष्ठ से सूचित करें — सुधार शीघ्र किया
        जाता है।
      </p>

      <h2>7. उत्तरदायित्व की सीमा</h2>
      <p>
        साइट "जैसी है वैसी" उपलब्ध कराई जाती है। सामग्री के उपयोग या उस पर निर्भरता से होने वाली
        किसी हानि — जिसमें परीक्षा परिणाम भी सम्मिलित है — के लिए साइट उत्तरदायी नहीं होगी। साइट की
        निरंतर उपलब्धता, त्रुटिरहित संचालन या किसी विशेष सामग्री के बने रहने की कोई गारंटी नहीं दी
        जाती।
      </p>

      <h2>8. बाहरी लिंक</h2>
      <p>
        कहीं-कहीं अन्य वेबसाइटों के लिंक दिए जा सकते हैं। उन साइटों की सामग्री, उपलब्धता या
        नीतियों पर हमारा कोई नियंत्रण नहीं है और उनके लिए हम उत्तरदायी नहीं हैं।
      </p>

      <h2>9. शुल्क और विज्ञापन</h2>
      <p>
        यह साइट निःशुल्क है। यहाँ कोई सशुल्क सदस्यता नहीं है और न ही किसी प्रकार का भुगतान माँगा
        जाता है। यदि भविष्य में साइट के संचालन-व्यय हेतु कोई व्यवस्था की जाती है, तो उसकी सूचना
        स्पष्ट रूप से दी जाएगी।
      </p>

      <h2>10. शर्तों में परिवर्तन</h2>
      <p>
        ये शर्तें समय-समय पर संशोधित की जा सकती हैं। संशोधन इसी पृष्ठ पर प्रकाशित होगा और ऊपर दी गई
        तिथि बदल दी जाएगी। परिवर्तन के बाद साइट का उपयोग जारी रखना नई शर्तों की स्वीकृति माना जाएगा।
      </p>

      <h2>11. लागू विधि</h2>
      <p>
        इन शर्तों की व्याख्या और इनसे उत्पन्न किसी विवाद पर भारत की विधि लागू होगी।
      </p>

      <h2>12. संपर्क</h2>
      <p>
        इन शर्तों के बारे में कोई प्रश्न हो तो
        <a href={`mailto:${CONTACT_EMAIL}`} class="latin">{CONTACT_EMAIL}</a> पर लिखें। आपकी जानकारी
        के उपयोग के बारे में <a href="/privacy/">गोपनीयता नीति</a> देखें।
      </p>
    </div>
  </div>
</BaseLayout>

---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Share card and social metadata — see Seo.astro for the defaults. */
  image?: string;
  imageAlt?: string;
  ogType?: string;
  keywords?: string;
}

const { title, description, schema, noindex, image, imageAlt, ogType, keywords } = Astro.props;
---

<!doctype html>
<html lang="hi" dir="ltr">
  <head>
    <Seo
      title={title}
      description={description}
      schema={schema}
      noindex={noindex}
      image={image}
      imageAlt={imageAlt}
      ogType={ogType}
      keywords={keywords}
    />
    {
      /* Resolves the theme before first paint so a reader who prefers
         dark never sees a white flash. Inlined on purpose: an external
         script would run too late. */
    }
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme =
            stored === 'dark' || stored === 'light' ? stored : prefersDark ? 'dark' : 'light';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-surface focus:px-4 focus:py-2 focus:text-ink focus:shadow-float"
    >
      मुख्य सामग्री पर जाएँ
    </a>

    {
      /* The seven-खंड spectrum, pinned to the top edge of every page —
         the site's one decorative device, standing in for DESIGN.md's
         hero mesh gradient. */
    }
    <div class="spectrum-rule" role="presentation"></div>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <SearchDialog />
  </body>
</html>

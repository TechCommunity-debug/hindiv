---
import { Font } from 'astro:assets';
import { SITE_NAME, OG_IMAGE, OG_IMAGE_ALT, SITE_KEYWORDS } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD to merge into the page, e.g. Article or FAQ schema. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /**
   * Share card, as a site-root path. Pages that have their own card pass
   * one; everything else shares the default, which is generated by
   * scripts/generate-og.mjs and committed under public/.
   */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** og:type — 'website' for listings, 'article' for topic pages. */
  ogType?: string;
  /**
   * Comma-separated keywords. Google ignores this tag, but several Hindi
   * aggregators and in-site search appliances still read it, and it costs
   * one line — so the terms a page is actually written for are declared.
   */
  keywords?: string;
}

const {
  title,
  description,
  schema,
  noindex = false,
  image = OG_IMAGE,
  imageAlt = OG_IMAGE_ALT,
  imageWidth = 1672,
  imageHeight = 941,
  ogType = 'website',
  keywords = SITE_KEYWORDS,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* A pipe, not a dash: topic titles already contain an em dash ("संधि —
   परिभाषा, भेद और उदाहरण"), and a second one made the brand read as a
   third clause of the heading rather than as the site it sits on. */
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL(image, Astro.site).href;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonical} />
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    /* max-image-preview:large is what lets the share card above be used as
       the thumbnail in Discover and in image-rich result layouts, which is
       where a Hindi study query gets most of its mobile traffic. */
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  )
}

{/* The site is Hindi throughout; declaring it lets browsers pick correct
    Devanagari shaping, hyphenation and speech synthesis voices. */}
<meta property="og:locale" content="hi_IN" />
<meta property="og:locale:alternate" content="en_IN" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

{/* summary_large_image, not summary: the card is a 1.91:1 render built for
    exactly this slot, and the small card would centre-crop it to a square
    that cuts the title in half. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="author" content={SITE_NAME} />
<meta name="language" content="Hindi" />
<meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#101012" media="(prefers-color-scheme: dark)" />

<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="HindiGram" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Only the sans face is preloaded. The serif is used for headings that
    sit below the fold on most pages, so preloading both would compete
    for bandwidth on exactly the slow connections this site targets. */}
<Font cssVariable="--font-devanagari-sans" preload />
<Font cssVariable="--font-devanagari-serif" />

{
  schemas.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
  ))
}

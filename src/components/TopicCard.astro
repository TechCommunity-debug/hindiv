---
import { levels } from '../lib/taxonomy';
import { categoryTitle, topicUrl, type Topic } from '../lib/content';

interface Props {
  topic: Topic;
  /** Show the khand name — useful in mixed lists, noise inside a khand. */
  showCategory?: boolean;
}

const { topic, showCategory = false } = Astro.props;
const { title, titleEn, summary, level, category } = topic.data;
const levelInfo = levels[level];
---

{/* data-khand publishes this section's colour to everything inside. */}
<a
  href={topicUrl(topic)}
  data-khand={category}
  class="group relative flex flex-col overflow-hidden rounded-card border border-hairline bg-surface p-5 no-underline transition-colors hover:border-(--khand)"
>
  {/* A bar of the खंड's colour along the top edge — the card's only
      chrome, and enough to group a grid by section at a glance. */}
  <span
    class="absolute inset-x-0 top-0 h-0.5 bg-(--khand) opacity-60 transition-opacity group-hover:opacity-100"
    aria-hidden="true"></span>

  <div class="flex items-baseline gap-2">
    <h3 class="m-0 text-h3 font-semibold text-ink">{title}</h3>
    <span class="text-meta text-faint latin">{titleEn}</span>
  </div>

  <p class="mt-2 grow text-ui text-body">{summary}</p>

  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-meta">
    <span
      data-level={level}
      class="rounded-pill bg-(--level-soft) px-2 py-0.5 font-medium text-(--level)"
      title={levelInfo.hint}>{levelInfo.label}</span
    >
    {showCategory && <span class="text-(--khand)">{categoryTitle(category)}</span>}
    <span
      class="ml-auto text-(--khand) opacity-0 transition-opacity group-hover:opacity-100"
      aria-hidden="true">पढ़ें →</span
    >
  </div>
</a>

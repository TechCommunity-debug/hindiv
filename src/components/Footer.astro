---
import { categories } from '../lib/taxonomy';
import { categoryUrl } from '../lib/content';
import { PDF_LANDING_URL } from '../lib/pdf';
import { CONTACT_EMAIL, sitePages } from '../lib/site';

const year = new Date().getFullYear();
---

<footer
  class="mt-20 border-t border-hairline bg-canvas"
  style="padding-bottom: env(safe-area-inset-bottom, 0px)"
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1.2fr_2.4fr]">
      <div>
        <p class="font-serif text-h3 font-bold text-ink">Hindi vyakaran</p>
        <p class="mt-2 max-w-sm text-ui text-body">
          हिंदी व्याकरण का एक व्यवस्थित संदर्भ — सरल हिंदी में परिभाषाएँ, भेद, उदाहरण और अभ्यास।
        </p>
        <p class="mt-4 text-meta text-faint latin">hindivyakaran.net</p>
        <p class="mt-1 text-meta">
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-faint no-underline hover:text-ink latin">
            {CONTACT_EMAIL}
          </a>
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        <div>
          <p class="eyebrow">खंड</p>
          <ul class="mt-3 flex flex-col gap-2">
            {
              categories.map((category) => (
                <li data-khand={category.id}>
                  <a
                    href={categoryUrl(category.id)}
                    class="flex items-center gap-2.5 text-ui text-body no-underline hover:text-ink"
                  >
                    <span class="size-1.5 shrink-0 rounded-full bg-(--khand)" aria-hidden="true" />
                    <span class="latin text-faint">({category.titleEn})</span> {category.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="eyebrow">सामग्री</p>
          <ul class="mt-3 flex flex-col gap-2">
            <li>
              <a href="/" class="text-ui text-body no-underline hover:text-ink"
                ><span class="latin text-faint">(All topics)</span> सभी विषय</a
              >
            </li>
            <li>
              <a href="/shabdkosh/" class="text-ui text-body no-underline hover:text-ink"
                ><span class="latin text-faint">(Dictionary)</span> शब्दकोश</a
              >
            </li>
            <li>
              <a href={PDF_LANDING_URL} class="text-ui text-body no-underline hover:text-ink"
                ><span class="latin text-faint">(Grammar PDF)</span> व्याकरण PDF</a
              >
            </li>
            <li>
              <a href="/parichay/" class="text-ui text-body no-underline hover:text-ink"
                ><span class="latin text-faint">(Introduction)</span> परिचय</a
              >
            </li>
            <li>
              <a href="/sitemap-index.xml" class="text-ui text-body no-underline hover:text-ink"
                ><span class="latin text-faint">(Sitemap)</span> साइटमैप</a
              >
            </li>
          </ul>
        </div>

        {/* The standing pages. Listed by name rather than folded into a
            fine-print line, so a reader looking for the privacy policy or a
            way to write in finds it in the same place as everything else. */}
        <div>
          <p class="eyebrow">साइट</p>
          <ul class="mt-3 flex flex-col gap-2">
            {
              sitePages.map((page) => (
                <li>
                  <a href={page.href} class="text-ui text-body no-underline hover:text-ink">
                    <span class="latin text-faint">({page.labelEn})</span> {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-12 border-t border-hairline pt-6 text-meta text-faint">
      © {year} Hindi vyakaran. शैक्षिक उपयोग के लिए स्वतंत्र।
    </p>
  </div>
</footer>

---
/**
 * Site-wide search — the dialog itself.
 *
 * Rendered once per page from the layout, deliberately NOT inside the
 * header's responsive wrappers: a <dialog> nested in a `display:none`
 * parent cannot be shown, which would have broken search on mobile
 * exactly where it matters most. Any element carrying `data-search-open`
 * anywhere on the page opens it. See SearchTrigger.astro.
 *
 * Opens on click, on "/" and on Ctrl/Cmd-K. The index is fetched once,
 * lazily, the first time the dialog is opened — so it costs nothing on
 * pages nobody searches from.
 */
---

<dialog
  data-search-dialog
  class="m-0 w-full max-w-2xl bg-transparent p-0 backdrop:bg-ink/25 backdrop:backdrop-blur-[2px] md:mx-auto md:mt-[10vh]"
  aria-label="खोज"
>
  <div
    class="flex max-h-[85vh] flex-col overflow-hidden rounded-panel border border-hairline bg-surface shadow-float"
  >
    <div class="flex items-center gap-3 border-b border-hairline px-4">
      <svg class="size-4 shrink-0 text-mute" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="m13.5 13.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
      <input
        type="search"
        data-search-input
        placeholder="विषय, शब्द या परिभाषा खोजें…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        class="grow bg-transparent py-4 text-lead text-ink outline-none placeholder:text-faint [&::-webkit-search-cancel-button]:hidden"
      />
      <button
        type="button"
        data-search-close
        class="shrink-0 rounded-control px-2 py-1 text-meta text-mute hover:text-ink"
        aria-label="बंद करें">Esc</button
      >
    </div>

    <div data-search-results class="overflow-y-auto overscroll-contain p-2" role="listbox">
      <p class="px-3 py-8 text-center text-ui text-mute" data-search-empty>
        नाम देवनागरी या रोमन में लिखें — जैसे <b class="text-body">संज्ञा</b> या
        <b class="text-body">sangya</b>
      </p>
    </div>

    <p class="border-t border-hairline px-4 py-2 text-meta text-faint">
      हिंदी और रोमन — दोनों में खोजा जा सकता है।
    </p>
  </div>
</dialog>

<script>
  import { search, type SearchRecord } from '../lib/search';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  if (!dialog || !input || !results) throw new Error('search markup missing');

  let records: SearchRecord[] | null = null;
  let loading = false;
  let active = -1;

  const escape = (s: string) =>
    s.replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );

  async function ensureIndex() {
    if (records || loading) return;
    loading = true;
    try {
      const response = await fetch('/search-index.json');
      records = (await response.json()) as SearchRecord[];
    } catch {
      records = [];
    } finally {
      loading = false;
      if (input!.value) render(input!.value);
    }
  }

  const KIND_LABEL: Record<string, string> = {
    topic: 'विषय',
    term: 'शब्द',
    khand: 'खंड',
  };

  // Written as whole literal class strings, never concatenated — Tailwind
  // scans this file as plain text and would not see a built-up name.
  const KIND_CLASS: Record<string, string> = {
    topic: 'bg-accent-soft text-accent',
    term: 'bg-ochre-soft text-ochre',
    khand: 'bg-correct-soft text-correct',
  };

  function render(query: string) {
    active = -1;
    const trimmed = query.trim();

    if (!trimmed) {
      results!.innerHTML = `<p class="px-3 py-8 text-center text-ui text-mute">नाम देवनागरी या रोमन में लिखें — जैसे <b class="text-body">संज्ञा</b> या <b class="text-body">sangya</b></p>`;
      return;
    }
    if (!records) {
      results!.innerHTML = `<p class="px-3 py-8 text-center text-ui text-mute">खोजा जा रहा है…</p>`;
      return;
    }

    const hits = search(records, trimmed);
    if (hits.length === 0) {
      results!.innerHTML = `<p class="px-3 py-8 text-center text-ui text-mute">“${escape(trimmed)}” से कुछ नहीं मिला।<br /><span class="text-meta">वर्तनी जाँचें या कोई छोटा शब्द आज़माएँ।</span></p>`;
      return;
    }

    results!.innerHTML = hits
      .map(
        ({ record }, i) => `
        <a href="${record.u}" role="option" data-result data-index="${i}"
           class="block rounded-card px-3 py-2.5 no-underline transition-colors hover:bg-sunken aria-selected:bg-sunken">
          <span class="flex items-baseline gap-2">
            <span class="font-serif text-h3 font-semibold text-ink">${escape(record.t)}</span>
            <span class="text-meta text-faint">${escape(record.te)}</span>
            <span class="ml-auto shrink-0 rounded-pill px-2 py-0.5 text-meta font-medium ${KIND_CLASS[record.kind] ?? 'text-mute'}">${KIND_LABEL[record.kind] ?? ''}</span>
          </span>
          <span class="mt-0.5 block line-clamp-2 text-meta text-body">${escape(record.s)}</span>
        </a>`,
      )
      .join('');
  }

  function move(delta: number) {
    const items = [...results!.querySelectorAll<HTMLAnchorElement>('[data-result]')];
    if (items.length === 0) return;
    active = (active + delta + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
    items[active]?.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (dialog!.open) return;
    dialog!.showModal();
    ensureIndex();
    // iOS Safari will not focus a field inside a dialog that opened in
    // the same frame, so hand it to the next one.
    requestAnimationFrame(() => input!.focus());
  }

  document.querySelectorAll('[data-search-open]').forEach((trigger) => {
    trigger.addEventListener('click', open);
  });
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());

  input.addEventListener('input', () => render(input.value));

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter' && active >= 0) {
      event.preventDefault();
      results.querySelectorAll<HTMLAnchorElement>('[data-result]')[active]?.click();
    }
  });

  // Clicking the backdrop closes; clicking the panel must not.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener('close', () => {
    input.value = '';
    render('');
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target?.tagName === 'INPUT' ||
      target?.tagName === 'TEXTAREA' ||
      target?.isContentEditable === true;

    if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      open();
    } else if (event.key === '/' && !typing && !dialog.open) {
      event.preventDefault();
      open();
    }
  });
</script>

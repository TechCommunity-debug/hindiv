---
/**
 * TelegramSmallBanner.astro
 *
 * Compact, natural Telegram channel banner for:
 * 1. Home page (below '7 खंड, 45 विषय — परिभाषा, भेद,...')
 * 2. Subtopic pages (at top level below header, dynamically including topicTitle)
 *
 * Designed to look like an organic study companion feature (not an ad),
 * extremely compact (< 30% screen height on mobile ~ 70-80px),
 * responsive, accessible, and elegant in both light and dark themes.
 */

interface Props {
  topicTitle?: string;
  class?: string;
}

const { topicTitle, class: className = '' } = Astro.props;
const TELEGRAM_URL = 'https://t.me/HindiGrammarMCQs';
const CHANNEL_HANDLE = '@HindiGrammarMCQs';
---

<aside
  class:list={[
    'telegram-small-banner not-prose group relative overflow-hidden rounded-card border border-[#229ED9]/30 bg-gradient-to-r from-[#229ED9]/10 via-surface to-[#229ED9]/5 p-3 sm:p-3.5 shadow-xs transition-colors hover:border-[#229ED9]/50 print:hidden',
    className,
  ]}
  aria-label="Telegram Quiz Channel"
>
  <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
    {/* Left: Icon + Text */}
    <div class="flex items-start gap-2.5 sm:items-center min-w-0">
      <div
        class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#229ED9]/15 text-[#229ED9] mt-0.5 sm:mt-0 transition-transform duration-200 group-hover:scale-105"
        aria-hidden="true"
      >
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="m20.665 3.717-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z" />
        </svg>
      </div>

      <p class="m-0 text-meta sm:text-ui leading-snug text-body">
        {topicTitle ? (
          <>
            <strong class="font-semibold text-ink">{topicTitle}</strong> और अन्य हिंदी व्याकरण के <span class="font-medium text-[#1378aa] dark:text-[#5bc4f5]">Daily MCQs / Quiz</span> अभ्यास (प्रतियोगी व बोर्ड परीक्षा) के लिए हमारे Telegram चैनल से जुड़ें।
          </>
        ) : (
          <>
            प्रतियोगी एवं बोर्ड परीक्षाओं के लिए रोज़ाना <span class="font-medium text-[#1378aa] dark:text-[#5bc4f5]">Hindi Grammar Daily MCQs / Quiz</span> अभ्यास हेतु Telegram चैनल से जुड़ें।
          </>
        )}
      </p>
    </div>

    {/* Right: Action Button */}
    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center justify-center gap-1.5 self-start sm:self-auto rounded-pill bg-[#229ED9] px-3.5 py-1.5 text-meta font-medium text-white no-underline shadow-xs transition-all hover:bg-[#1d8bc1] hover:shadow active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#229ED9]"
    >
      <span>Join Telegram Channel</span>
      <svg class="size-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 12L12 4H6M12 4V10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</aside>

<style>
  @media print {
    .telegram-small-banner {
      display: none !important;
    }
  }
</style>
